<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Barbería Elite</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #111;
            color: white;
        }

        /* MENU */

        header {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(0, 0, 0, 0.95);
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #d4a017;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            transition: 0.3s;
        }

        nav a:hover {
            color: #d4a017;
        }

        /* INICIO */

        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;

            background:
                linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.8)),
                url("https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1600&q=80");

            background-size: cover;
            background-position: center;
        }

        .hero h1 {
            font-size: 60px;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 20px;
            color: #ddd;
            margin-bottom: 30px;
        }

        .boton {
            display: inline-block;
            background: #d4a017;
            color: black;
            padding: 15px 30px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 5px;
            transition: 0.3s;
        }

        .boton:hover {
            transform: scale(1.05);
            background: white;
        }

        /* SECCIONES */

        section {
            padding: 90px 10%;
        }

        .titulo {
            text-align: center;
            font-size: 35px;
            margin-bottom: 50px;
            color: #d4a017;
        }

        /* SERVICIOS */

        .servicios {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
        }

        .servicio {
            background: #1c1c1c;
            padding: 30px;
            border-radius: 10px;
            text-align: center;
            border: 1px solid #333;
            transition: 0.3s;
        }

        .servicio:hover {
            transform: translateY(-8px);
            border-color: #d4a017;
        }

        .servicio h3 {
            margin-bottom: 15px;
            font-size: 22px;
        }

        .precio {
            color: #d4a017;
            font-size: 24px;
            font-weight: bold;
            margin-top: 15px;
        }

        /* GALERIA */

        .galeria {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .galeria img {
            width: 100%;
            height: 300px;
            object-fit: cover;
            border-radius: 8px;
            transition: 0.3s;
        }

        .galeria img:hover {
            transform: scale(1.03);
        }

        /* CONTACTO */

        .contacto {
            background: #1a1a1a;
            text-align: center;
        }

        .contacto p {
            margin: 15px 0;
            color: #ccc;
            font-size: 18px;
        }

        footer {
            background: black;
            text-align: center;
            padding: 25px;
            color: #777;
        }

        /* RESPONSIVE */

        @media (max-width: 700px) {

            header {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 0 8px;
                font-size: 14px;
            }

            .hero h1 {
                font-size: 40px;
            }

            .hero p {
                font-size: 17px;
            }

            section {
                padding: 70px 7%;
            }
        }

    </style>
</head>

<body>

    <header>
        <div class="logo">✂ BARBERÍA ELITE</div>

        <nav>
            <a href="#inicio">Inicio</a>
            <a href="#servicios">Servicios</a>
            <a href="#galeria">Galería</a>
            <a href="#contacto">Contacto</a>
        </nav>
    </header>


    <!-- INICIO -->

    <section class="hero" id="inicio">

        <div>
            <h1>Tu estilo empieza aquí</h1>

            <p>
                Cortes modernos, estilo clásico y atención profesional.
            </p>

            <a href="https://wa.me/595000000000" class="boton">
                Reservar por WhatsApp
            </a>
        </div>

    </section>


    <!-- SERVICIOS -->

    <section id="servicios">

        <h2 class="titulo">Nuestros Servicios</h2>

        <div class="servicios">

            <div class="servicio">
                <h3>✂ Corte de Cabello</h3>
                <p>
                    Cortes clásicos y modernos adaptados a tu estilo.
                </p>
                <div class="precio">₲ 40.000</div>
            </div>

            <div class="servicio">
                <h3>🪒 Corte + Barba</h3>
                <p>
                    Servicio completo para un look impecable.
                </p>
                <div class="precio">₲ 60.000</div>
            </div>

            <div class="servicio">
                <h3>🧔 Diseño de Barba</h3>
                <p>
                    Perfilado y cuidado profesional de tu barba.
                </p>
                <div class="precio">₲ 30.000</div>
            </div>

        </div>

    </section>


    <!-- GALERIA -->

    <section id="galeria">

        <h2 class="titulo">Nuestros Trabajos</h2>

        <div class="galeria">

            <img src="https://images.unsplash.com/photo-1622286342621-4bd786c2447c?auto=format&fit=crop&w=800&q=80">

            <img src="https://images.unsplash.com/photo-1599351431202-1e0f0137899a?auto=format&fit=crop&w=800&q=80">

            <img src="https://images.unsplash.com/photo-1517832606299-7ae9b720a186?auto=format&fit=crop&w=800&q=80">

        </div>

    </section>


    <!-- CONTACTO -->

    <section class="contacto" id="contacto">

        <h2 class="titulo">Visítanos</h2>

        <p>📍 Asunción, Paraguay</p>

        <p>📞 +595 000 000 000</p>

        <p>🕒 Lunes a Sábado: 09:00 - 20:00</p>

        <br>

        <a href="https://wa.me/595000000000" class="boton">
            Agendar mi turno
        </a>

    </section>


    <footer>
        <p>© 2026 Barbería Elite - Todos los derechos reservados</p>
    </footer>

</body>
</html>
